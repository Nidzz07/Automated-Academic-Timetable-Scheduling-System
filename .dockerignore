# Build context is the repo root; keep the image small and platform-clean.
# .venv especially: it holds Windows binaries that must not land in a Linux image.
.venv/
venv/
env/
__pycache__/
*.py[cod]
.pytest_cache/
.hypothesis/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
.coverage.*

.git/
.gitignore
.vscode/
.idea/

frontend/node_modules/
frontend/dist/

# Every .env at any depth (".env" alone matches only the repo root; backend/.env holds
# local secrets). .env.example is not needed in an image.
**/.env
**/.env.*
*.md
