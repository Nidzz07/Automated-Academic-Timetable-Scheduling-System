# Template for backend/.env — copy it there and fill in.
# backend/.env is gitignored; this template is not. Never commit real credentials.
#
#   Copy-Item .env.example backend\.env

# --- Supabase Postgres ---
# Supabase dashboard > Project Settings > Database > Connection string > URI.
# Add the SQLAlchemy driver prefix (postgresql+psycopg2://) and sslmode=require.
#
# Use the DIRECT connection (port 5432) for Alembic migrations — the transaction
# pooler on port 6543 does not support the prepared statements SQLAlchemy issues.
DATABASE_URL=postgresql+psycopg2://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require

# --- Auth (JWT) ---
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=30
