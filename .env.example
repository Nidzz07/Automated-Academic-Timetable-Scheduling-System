# Every key the backend reads, names only. Copy it to backend/.env and fill in the values
# (backend/.env is gitignored; never commit real credentials):
#
#   Copy-Item .env.example backend\.env
#
# The environment wins over backend/.env. On Render (ROADMAP D55) set them as the service's
# environment variables instead; see README.md "Deploy (D55)".

# Postgres for users, the audit log and solve jobs (db/local_guard.py). Local Docker:
# postgresql+psycopg2://chronos:chronos@localhost:<CHRONOS_DB_PORT>/chronos
DATABASE_URL=

# HS256 signing key for access tokens, at least 32 characters, one per environment.
SECRET_KEY=

# Access-token lifetime in minutes; empty means 30.
ACCESS_TOKEN_EXPIRE_MINUTES=

# Password of the demo accounts, read by python -m backend.app.demo_seed only.
CHRONOS_DEMO_PASSWORD=

# Built frontend served by backend.app.prod; empty means frontend/dist.
CHRONOS_FRONTEND_DIST=

# Port backend/Dockerfile.prod listens on; Render sets it; empty means 8000.
PORT=

# Also read (db/local_guard.py, migrations/env.py), but never put it in a file:
# CHRONOS_ALLOW_REMOTE_DB lets one command use a non-local database. A human sets it for
# that one command only (D55); agents never do.
