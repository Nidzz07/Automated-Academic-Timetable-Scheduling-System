# Copy to .env and fill in. .env is gitignored; this template is not.

# --- Postgres (consumed by docker-compose.yml) ---
POSTGRES_USER=chronos
POSTGRES_PASSWORD=chronos
POSTGRES_DB=chronos

# --- Backend ---
# Inside Docker the host is `db`; running uvicorn on the host use `localhost`.
DATABASE_URL=postgresql+psycopg2://chronos:chronos@localhost:5432/chronos

# --- Auth (JWT) ---
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=30
