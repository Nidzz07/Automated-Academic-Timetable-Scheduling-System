# Every variable the backend reads, with safe local values. Copy it to backend/.env and fill in
# what is empty (backend/.env is gitignored; never commit real credentials):
#
#   Copy-Item .env.example backend\.env
#
# The environment wins over backend/.env. On Render (ROADMAP D55) set them as the service's
# environment variables instead; see README.md "Deploy".

# Postgres for users, the audit log and solve jobs (db/local_guard.py): the local Docker one.
# Use your CHRONOS_DB_PORT (docker compose and the tests read it) if 5432 is taken.
DATABASE_URL=postgresql+psycopg2://chronos:chronos@localhost:5432/chronos

# HS256 signing key for access tokens, at least 32 characters, one per environment. The app
# refuses to start without it. Make one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Access-token lifetime in minutes, 5 to 1440.
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Demo account passwords (at least 8 characters), read by python -m backend.app.demo_seed only.
# CHRONOS_DEMO_PASSWORD is used for every account whose own variable is empty.
CHRONOS_DEMO_PASSWORD=
CHRONOS_DEMO_PASSWORD_ADMIN=
CHRONOS_DEMO_PASSWORD_COORDINATOR=
CHRONOS_DEMO_PASSWORD_FACULTY=
CHRONOS_DEMO_PASSWORD_STUDENT=

# Built frontend served by backend.app.prod; empty means frontend/dist.
CHRONOS_FRONTEND_DIST=

# Port backend/Dockerfile.prod listens on; Render sets it.
PORT=8000

# Also read (db/local_guard.py, migrations/env.py), but NEVER put it in this file or any .env
# file (D57): CHRONOS_ALLOW_REMOTE_DB=1 lets the app use a non-local database. Only the Render
# service sets it, by hand in Render; Nidhi sets it in her own terminal for the hand-run
# alembic and demo_seed commands only (D55, D59). Agents never set it.
