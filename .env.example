# Template for backend/.env — copy it there and fill in.
# backend/.env is gitignored; this template is not. Never commit real credentials.
#
#   Copy-Item .env.example backend\.env

# ============================================================================
# Database
# ============================================================================
# Two targets, and it matters which one you point at:
#
#   LOCAL Postgres (docker compose `db` service)  → development and ALL migrations.
#       Throwaway, yours alone. Run `alembic upgrade head` here freely.
#   SUPABASE (hosted)                             → shared staging ONLY.
#       One instance for the whole team. Three people running Alembic against it
#       corrupt each other's schema state. Coordinate before you touch it, and
#       never point test fixtures or destructive operations at it.
#
# Set DATABASE_URL to whichever you are working against — default to local.

# --- Local Postgres (docker compose) ---
# Credentials are defined in docker-compose.yml: user/password/db all "chronos".
# From inside the compose network (the backend container), the host is `db`:
# LOCAL_DATABASE_URL=postgresql+psycopg2://chronos:chronos@db:5432/chronos
# From the Windows host (running uvicorn or alembic outside Docker), use localhost:
# LOCAL_DATABASE_URL=postgresql+psycopg2://chronos:chronos@localhost:5432/chronos
DATABASE_URL=postgresql+psycopg2://chronos:chronos@localhost:5432/chronos

# --- Supabase Postgres (shared staging) ---
# Supabase dashboard > Project Settings > Database > Connection string > URI.
# Add the SQLAlchemy driver prefix (postgresql+psycopg2://) and sslmode=require.
#
# Use the DIRECT connection (port 5432) for Alembic migrations — the transaction
# pooler on port 6543 does not support the prepared statements SQLAlchemy issues.
# DATABASE_URL=postgresql+psycopg2://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require

# ============================================================================
# Auth (JWT)
# ============================================================================
# Signing key for access tokens. Generate a fresh random value per environment;
# never reuse this placeholder outside local development.
SECRET_KEY=change-me

# JWT signing algorithm passed to python-jose. HS256 = symmetric, uses SECRET_KEY.
ALGORITHM=HS256

# Access-token lifetime in minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ============================================================================
# Runtime
# ============================================================================
# Which environment this process is running as: development | staging | production.
ENVIRONMENT=development

# Verbose errors and auto-reload. Must be false anywhere that is not a dev machine.
DEBUG=true
